// P04 · 8月核心数据总览（Hero）
<Slide>
    {/* 背景：暖砂 */}
    <Box style={{
        position: 'absolute', left: 0, top: 0,
        width: '100%', height: '100%',
        background: '#F5EFE6',
    }} />

    {/* 左侧 8% 暖驼色装饰条 */}
    <Box style={{
        position: 'absolute', left: 0, top: 0,
        width: 8, height: '100%',
        background: 'linear-gradient(180deg, #3E2F23 0%, #C08A5E 100%)',
    }} />

    {/* 右上陶土红强调色块（L1 视觉辅佐） */}
    <Box style={{
        position: 'absolute', right: 0, top: 0,
        width: 200, height: 200,
        background: 'linear-gradient(135deg, #D65A3F 0%, transparent 70%)',
        opacity: 0.18,
    }} />

    {/* A 块：标题 */}
    <Box style={{
        position: 'absolute', left: 60, top: 36, right: 60, height: 64,
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
    }}>
        <Text style={{
            fontSize: 36, fontWeight: 'bold', color: '#3E2F23',
        }}>
            8月核心数据总览
        </Text>
        <Text style={{
            fontSize: 16, color: '#6B5B4B', letterSpacing: 4, fontWeight: 500,
        }}>
            KEY METRICS · AUG 2026
        </Text>
    </Box>

    {/* B 块：核心数字 + 7 指标 + 洞察 */}
    <Box style={{
        position: 'absolute', left: 60, top: 140, right: 60, height: 500,
        flexDirection: 'column', gap: 16,
    }}>
        {/* 副标签 + 巨型数字 */}
        <Box style={{
            alignItems: 'center', justifyContent: 'center',
            height: 180,
        }}>
            <Text style={{
                fontSize: 18, color: '#6B5B4B',
                letterSpacing: 4, fontWeight: 500, marginBottom: 12,
            }}>
                8月兼职团队总销售额
            </Text>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
                <Text style={{
                    fontSize: 32, color: '#D65A3F', fontWeight: 'bold',
                    fontFamily: 'Arial, Helvetica Neue, sans-serif',
                }}>
                    ¥
                </Text>
                <Text style={{
                    fontSize: 128, color: '#3E2F23', fontWeight: 'bold',
                    lineHeight: 1.0, letterSpacing: -2,
                    fontFamily: 'Arial, Helvetica Neue, sans-serif',
                }}>
                    67,532
                </Text>
            </Box>
        </Box>

        {/* 4 主指标卡 */}
        <Box style={{
            flexDirection: 'row', gap: 16,
            justifyContent: 'center',
        }}>
            {[
                { num: '61', unit: '件', label: '销售件数' },
                { num: '46', unit: '票', label: '成交小票' },
                { num: '¥1,468', unit: '', label: '客单价' },
                { num: '1.33', unit: '', label: 'UPT' },
            ].map((m, i) => (
                <Box key={i} style={{
                    width: 240, height: 96,
                    background: '#FFFFFF',
                    borderRadius: 10,
                    padding: 16,
                    flexDirection: 'column', justifyContent: 'center', alignItems: 'center',
                    boxShadow: '0 4px 16px rgba(62,47,35,0.08)',
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 4 }}>
                        <Text style={{
                            fontSize: 36, fontWeight: 'bold', color: '#3E2F23',
                            fontFamily: 'Arial, Helvetica Neue, sans-serif',
                        }}>
                            {m.num}
                        </Text>
                        {m.unit ? (
                            <Text style={{
                                fontSize: 16, color: '#6B5B4B', fontWeight: 500,
                            }}>
                                {m.unit}
                            </Text>
                        ) : null}
                    </Box>
                    <Text style={{
                        fontSize: 14, color: '#6B5B4B',
                        letterSpacing: 1, marginTop: 4,
                    }}>
                        {m.label}
                    </Text>
                </Box>
            ))}
        </Box>

        {/* 3 副指标条 */}
        <Box style={{
            flexDirection: 'row', gap: 24,
            justifyContent: 'center',
        }}>
            {[
                { num: '12', label: '人有产出' },
                { num: '634.5h', label: '总工时' },
                { num: '9', label: '条顾客好评' },
            ].map((m, i) => (
                <Box key={i} style={{
                    width: 200, height: 56,
                    flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 12,
                    background: 'rgba(192,138,94,0.12)',
                    borderRadius: 8,
                }}>
                    <Text style={{
                        fontSize: 24, fontWeight: 'bold', color: '#3E2F23',
                        fontFamily: 'Arial, Helvetica Neue, sans-serif',
                    }}>
                        {m.num}
                    </Text>
                    <Text style={{ fontSize: 16, color: '#6B5B4B' }}>
                        {m.label}
                    </Text>
                </Box>
            ))}
        </Box>

        {/* 洞察条 */}
        <Box style={{
            height: 70, padding: 18, paddingLeft: 24, paddingRight: 24,
            background: '#3E2F23',
            borderRadius: 10,
            flexDirection: 'row', alignItems: 'center', gap: 20,
        }}>
            <Box style={{
                width: 4, height: 36,
                background: '#D65A3F',
            }} />
            <Text style={{
                fontSize: 18, color: '#F5EFE6', lineHeight: 1.5,
            }}>
                15人 × 634.5小时 = ¥6.75万营收，团队整体时产
                <span style={{ color: '#D65A3F', fontWeight: 'bold', fontSize: 22 }}> ¥106/h </span>
                —— 盘子是稳的，结构才是下一章要解的事
            </Text>
        </Box>
    </Box>

    {/* C 块：页脚条 */}
    <Box style={{
        position: 'absolute', left: 60, right: 60, bottom: 20, height: 24,
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
    }}>
        <Text style={{ fontSize: 14, color: '#6B5B4B' }}>
            安福路 Salomon 兼职管理 · 8月复盘
        </Text>
        <Text style={{
            fontSize: 14, color: '#6B5B4B',
            fontFamily: 'Arial, Helvetica Neue, sans-serif',
        }}>
            04 / 10
        </Text>
    </Box>
</Slide>
