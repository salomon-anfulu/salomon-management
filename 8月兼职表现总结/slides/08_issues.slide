                    }}>
                        头部依赖 47.3%
                    </Text>
                    <Text style={{
                        fontSize: 15, color: '#6B5B4B', lineHeight: 1.55,
                    }}>
                        TOP 3 销售额占总盘
                        <span style={{ color: '#D65A3F', fontWeight: 'bold' }}> 47.3% </span>
